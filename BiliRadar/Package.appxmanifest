<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop com rescap">

  <Identity
    Name="JordanQD.FeedPeek.Preview"
    Publisher="CN=55B82F9D-39B5-4EC7-8696-862731CE35AA"
    Version="2.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="23003471-ae17-4749-9f8d-70d18b9c50c5" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>FeedPeek</DisplayName>
    <PublisherDisplayName>Jordan_QD</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="zh-HK" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="BiliRadar.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="FeedPeek"
        Description="通用更新查看器"
        BackgroundColor="#000000"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="B3236FC5-4B54-46E5-AC8C-5538956807C5" />
        </desktop:Extension>
        <desktop:Extension Category="windows.startupTask" Executable="BiliRadar.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="FeedPeekPreviewStartupTask" Enabled="false" DisplayName="FeedPeek" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="BiliRadar.exe" DisplayName="FeedPeek" Arguments="----AppNotificationActivated:">
              <com:Class Id="B3236FC5-4B54-46E5-AC8C-5538956807C5" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
