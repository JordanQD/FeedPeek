<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BiliRadar.Pages.SourcesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:BiliRadar.Models">

    <ScrollView
        x:Name="SettingsScrollView"
        Padding="36,32,36,0"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsScrollView.Padding" Value="36,32,36,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsScrollView.Padding" Value="12,16,12,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Margin="0,0,0,32" MaxWidth="1064" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Margin="0,0,0,12" Style="{ThemeResource TitleTextBlockStyle}" Text="来源" />

            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="网站插件" />
            <controls:SettingsCard
                x:Name="VideoSitePluginCard"
                Description="登录为此网站插件下需要账户权限的来源授权；无需登录的来源不受影响。"
                Header="哔哩哔哩"
                HorizontalContentAlignment="Stretch">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsCard.HeaderIcon>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture
                        x:Name="SiteAccountAvatar"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="SiteAccountNameText"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="未登录" />
                        <TextBlock
                            x:Name="SiteAccountDetailText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="登录状态由此网站下需要账户权限的来源共享。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="SiteLoginActionButton"
                        Grid.Column="2"
                        Width="40"
                        Height="40"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="网站插件登录操作"
                        Click="SiteLoginActionButton_Click"
                        ToolTipService.ToolTip="网页登录">
                        <FontIcon x:Name="SiteLoginActionIcon" Glyph="&#xE77B;" />
                    </Button>
                </Grid>
            </controls:SettingsCard>

            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="添加 RSS 来源" />
            <controls:SettingsCard
                Description="输入网站地址或 RSS / Atom 地址，FeedPeek 会自动发现可用订阅。"
                Header="订阅地址"
                HorizontalContentAlignment="Stretch">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsCard.HeaderIcon>
                <Grid MinWidth="360" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="EndpointTextBox"
                        PlaceholderText="https://example.com/feed.xml"
                        KeyDown="EndpointTextBox_KeyDown" />
                    <Button
                        x:Name="AddButton"
                        Grid.Column="1"
                        Click="AddButton_Click"
                        Content="添加" />
                </Grid>
            </controls:SettingsCard>

            <InfoBar
                x:Name="StatusInfoBar"
                IsClosable="True"
                IsOpen="False" />

            <TextBlock Margin="0,12,0,0" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="已添加的 RSS 来源" />
            <controls:SettingsCard HorizontalContentAlignment="Stretch">
                <Grid MinHeight="180">
                    <ListView
                        x:Name="SourcesListView"
                        IsItemClickEnabled="False"
                        IsSwipeEnabled="False"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FeedSourceRow">
                                <Grid Padding="12,10" ColumnSpacing="12" AutomationProperties.Name="{x:Bind DisplayName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            Text="{x:Bind Endpoint}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind ItemCountText, Mode=OneWay}" />
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="·" />
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind UnreadCountText, Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Click="DeleteButton_Click"
                                        DataContext="{x:Bind}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="删除来源">
                                        <FontIcon Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="EmptyPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <FontIcon HorizontalAlignment="Center" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE774;" />
                        <TextBlock FontWeight="SemiBold" Text="还没有 RSS 来源" />
                    </StackPanel>
                </Grid>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollView>
</Page>
