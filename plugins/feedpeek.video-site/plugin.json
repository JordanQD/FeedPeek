{
  "pluginId": "feedpeek.video-site",
  "version": "1.1.0",
  "apiVersion": 1,
  "displayName": "视频站点适配器",
  "entry": "index.js",
  "preloadScripts": [],
  "capabilities": [
    "feed.updates",
    "account.auth",
    "account.profile",
    "account.history",
    "collection.viewLater",
    "item.actions",
    "creator.following",
    "creator.actions",
    "feed.live"
  ],
  "auth": {
    "required": true,
    "kind": "webview-cookie",
    "cookieDomains": [
      "api.bilibili.com",
      "api.live.bilibili.com",
      "www.bilibili.com",
      "passport.bilibili.com"
    ],
    "authSignalCookies": [
      "SESSDATA",
      "bili_jct",
      "DedeUserID"
    ],
    "exposedCookieNames": [
      "bili_jct"
    ],
    "loginFlow": {
      "loginUrl": "https://passport.bilibili.com/login",
      "successUrlPrefixes": [
        "https://www.bilibili.com/"
      ],
      "successCookieNames": [
        "SESSDATA",
        "bili_jct",
        "DedeUserID"
      ]
    }
  },
  "network": {
    "allowedHosts": [
      "api.bilibili.com",
      "api.live.bilibili.com"
    ],
    "allowRedirectHosts": []
  },
  "views": [
    {
      "id": "updates",
      "kind": "feed",
      "title": "更新"
    },
    {
      "id": "history",
      "kind": "feed",
      "title": "历史记录"
    },
    {
      "id": "viewLater",
      "kind": "collection",
      "title": "稍后再看"
    },
    {
      "id": "live",
      "kind": "live",
      "title": "正在直播"
    }
  ]
}
