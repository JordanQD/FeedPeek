<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Native Button state brushes, loaded only in thumbnail-overlay buttons. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonBackground" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#66FFFFFF" />

            <SolidColorBrush x:Key="ButtonForeground" Color="#D9000000" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E6000000" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF000000" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#66000000" />

            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#33000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#66000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#80000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#1A000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ButtonBackground" Color="#995C5C5C" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E6222222" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF181818" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#66303030" />

            <SolidColorBrush x:Key="ButtonForeground" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#66FFFFFF" />

            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#50FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#87FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#B4FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#26FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="ButtonBackground" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SystemColorButtonFaceColorBrush" />

            <StaticResource x:Key="ButtonForeground" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="SystemColorGrayTextColorBrush" />

            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SystemColorGrayTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
