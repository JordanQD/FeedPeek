<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Modal dialog brushes.
         ============================================================ -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">

            <SolidColorBrush x:Key="ModalDialogBackgroundBrush" Color="#FFF9F9F9" />
            <SolidColorBrush x:Key="ModalDialogBorderBrush" Color="#33000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="ModalDialogBackgroundBrush" Color="#FF2C2C2C" />
            <SolidColorBrush x:Key="ModalDialogBorderBrush" Color="#50FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">

            <StaticResource x:Key="ModalDialogBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="ModalDialogBorderBrush" ResourceKey="SystemColorButtonTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ============================================================
         Duration badge — always dark, on top of cover images.
         ============================================================ -->

    <SolidColorBrush x:Key="DurationBadgeBackgroundBrush" Color="#B4000000" />
    <SolidColorBrush x:Key="DurationBadgeForegroundBrush" Color="#FFFFFF" />

    <!-- ============================================================
         Settings page shared styles.
         ============================================================ -->

    <x:Double x:Key="SettingsCardSpacing">4</x:Double>

    <Style
        x:Key="SettingsSectionHeaderTextBlockStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="0,32,0,4" />
    </Style>

    <!--  ============================================================
          BreadcrumbBar 轻量样式（参考 Windows Terminal 设置页）。
          只覆写主题资源，不重写 ControlTemplate。
          ============================================================  -->
    <x:Double x:Key="BreadcrumbBarItemThemeFontSize">30</x:Double>
    <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
    <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
    <Thickness x:Key="BreadcrumbBarChevronPadding">8,4,8,0</Thickness>

</ResourceDictionary>
