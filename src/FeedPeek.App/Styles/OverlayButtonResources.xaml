<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Named style for cover-overlay icon buttons (save / remove).
      Replaces the old per-row <Button.Resources><ResourceDictionary Source=.../></Button.Resources>
      which allocated a dictionary on every realised item.
      Overlay brushes are defined in SharedResources.xaml theme dictionaries.
    -->
    <Style x:Key="OverlayIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource OverlayButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OverlayButtonForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OverlayButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    </Style>
</ResourceDictionary>
