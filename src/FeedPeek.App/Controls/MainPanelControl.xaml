<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FeedPeek.Controls.MainPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Width="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="8,2,12,4"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <SelectorBar
                x:Name="ContentSelectorBar"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                SelectionChanged="ContentSelectorBar_SelectionChanged">
                <SelectorBarItem
                    x:Name="FollowingSelectorItem"
                    x:Uid="MainFollowingSelectorItem"
                    Icon="Contact"
                    Text="关注" />
                <SelectorBarItem
                    x:Name="HistorySelectorItem"
                    x:Uid="MainHistorySelectorItem"
                    Icon="Clock"
                    Text="历史" />
                <SelectorBarItem
                    x:Name="ViewLaterSelectorItem"
                    x:Uid="MainViewLaterSelectorItem"
                    Icon="Favorite"
                    Text="稍后再看" />
            </SelectorBar>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="FilterButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="筛选来源">
                    <FontIcon
                        FontSize="15"
                        Glyph="&#xE71C;" />
                    <Button.Flyout>
                        <MenuFlyout
                            x:Name="FilterMenuFlyout"
                            Placement="BottomEdgeAlignedRight"
                            Opening="FilterMenuFlyout_Opening">
                            <MenuFlyout.Items>
                                <RadioMenuFlyoutItem
                                    x:Name="FilterAllItem"
                                    GroupName="PanelSourceFilter"
                                    IsChecked="True"
                                    Text="全部"
                                    Click="FilterMenuItem_Click" />
                                <MenuFlyoutSeparator x:Name="FilterSeparator" />
                            </MenuFlyout.Items>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="RefreshButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="RefreshButton_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="刷新更新">
                    <FontIcon FontSize="15" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Frame
                x:Name="ContentFrame"
                CacheSize="0"
                IsNavigationStackEnabled="False" />

            <Grid
                x:Name="StatusNotificationLayer"
                Canvas.ZIndex="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed">
                <InfoBar
                    x:Name="StatusInfoBar"
                    Height="64"
                    MinHeight="64"
                    MaxHeight="64"
                    Margin="12,0,12,16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    IsClosable="True"
                    IsOpen="False"
                    CloseButtonClick="StatusNotificationInfoBar_CloseButtonClick">
                    <TextBlock
                        x:Name="StatusInfoBarText"
                        VerticalAlignment="Center"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </InfoBar>
            </Grid>
        </Grid>

        <!-- Overlay: pinned to the very top edge above the rows above it. It is declared last and
             given a higher z-order, so it draws on top of the existing layout without reserving
             space or shifting the content while the session is busy. -->
        <ProgressBar
            x:Name="RefreshProgressBar"
            Grid.Row="0"
            Canvas.ZIndex="20"
            Height="3"
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
