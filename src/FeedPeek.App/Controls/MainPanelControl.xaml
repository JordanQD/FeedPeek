<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FeedPeek.Controls.MainPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Width="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="8,2,12,4"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <SelectorBar
                x:Name="ContentSelectorBar"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                SelectionChanged="ContentSelectorBar_SelectionChanged">
                <SelectorBarItem
                    x:Name="FollowingSelectorItem"
                    x:Uid="MainFollowingSelectorItem"
                    Icon="Contact"
                    Text="关注" />
                <SelectorBarItem
                    x:Name="HistorySelectorItem"
                    x:Uid="MainHistorySelectorItem"
                    Icon="Clock"
                    Text="历史" />
                <SelectorBarItem
                    x:Name="ViewLaterSelectorItem"
                    x:Uid="MainViewLaterSelectorItem"
                    Icon="Favorite"
                    Text="稍后再看" />
            </SelectorBar>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="FilterButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="筛选来源">
                    <FontIcon
                        FontSize="15"
                        Glyph="&#xE71C;" />
                    <Button.Flyout>
                        <MenuFlyout
                            x:Name="FilterMenuFlyout"
                            Placement="BottomEdgeAlignedRight"
                            Opening="FilterMenuFlyout_Opening">
                            <MenuFlyout.Items>
                                <RadioMenuFlyoutItem
                                    x:Name="FilterAllItem"
                                    GroupName="PanelSourceFilter"
                                    IsChecked="True"
                                    Text="全部"
                                    Click="FilterMenuItem_Click" />
                                <MenuFlyoutSeparator x:Name="FilterSeparator" />
                            </MenuFlyout.Items>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="OpenSiteButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="OpenSiteButton_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="打开源网站">
                    <FontIcon FontSize="15" Glyph="&#xE8A7;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Frame
                x:Name="ContentFrame"
                CacheSize="0"
                IsNavigationStackEnabled="False" />

            <Grid
                x:Name="StatusNotificationLayer"
                Canvas.ZIndex="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed">
                <InfoBar
                    x:Name="StatusInfoBar"
                    Height="64"
                    MinHeight="64"
                    MaxHeight="64"
                    Margin="12,0,12,16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    IsClosable="True"
                    IsOpen="False"
                    CloseButtonClick="StatusNotificationInfoBar_CloseButtonClick">
                    <TextBlock
                        x:Name="StatusInfoBarText"
                        VerticalAlignment="Center"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </InfoBar>
            </Grid>
        </Grid>

        <!-- Overlay: pinned to the very top edge above the rows above it. It is declared last and
             given a higher z-order, so it draws on top of the existing layout without reserving
             space or shifting the content while the session is busy. -->
        <ProgressBar
            x:Name="RefreshProgressBar"
            Grid.Row="0"
            Canvas.ZIndex="20"
            Height="3"
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="Collapsed" />

        <!-- In-panel modal. ContentDialog on this XAML island leaves its smoke layer outside the
             DesktopFlyout, so the prompt is hosted here. Span all rows so it floats over the whole
             panel like a dialog, not just the header strip. -->
        <Grid
            x:Name="WebsiteDialogLayer"
            Grid.Row="0"
            Grid.RowSpan="2"
            Canvas.ZIndex="40"
            Background="#99000000"
            Visibility="Collapsed">
            <Border
                Width="320"
                Margin="24"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource ModalDialogBackgroundBrush}"
                BorderBrush="{ThemeResource ModalDialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <TextBlock
                        x:Name="WebsiteDialogTitle"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="打开源网站" />
                    <TextBox
                        x:Name="WebsiteDialogInput"
                        PlaceholderText="https://" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button
                            x:Name="WebsiteDialogCancelButton"
                            Content="取消"
                            Click="WebsiteDialogCancelButton_Click" />
                        <Button
                            x:Name="WebsiteDialogConfirmButton"
                            Content="保存并打开"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="WebsiteDialogConfirmButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
