<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FeedPeek.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="titleBar"
            Title="FeedPeek"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Square44x44Logo.targetsize-24_altform-unplated.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="navView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            CompactPaneLength="48"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <!--  顶栏留白参考 WinUI Gallery "All" 页，但左边与内容对齐（24）  -->
                    <Thickness x:Key="NavigationViewHeaderMargin">0,0,0,0</Thickness>
                </ResourceDictionary>
            </NavigationView.Resources>

            <NavigationView.Header>
                <Grid x:Name="HeaderGrid" Padding="24,24,24,0">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="WideHeader">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="640" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="HeaderGrid.Padding" Value="24,24,24,0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="NarrowHeader">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="HeaderGrid.Padding" Value="16,24,16,0" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <BreadcrumbBar
                        x:Name="NavigationBreadcrumb"
                        MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        ItemClicked="NavigationBreadcrumb_ItemClicked" />
                </Grid>
            </NavigationView.Header>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="GeneralNavItem"
                    x:Uid="SettingsGeneralNavItem"
                    Content="通用"
                    Icon="Setting"
                    Tag="general" />
                <NavigationViewItem
                    Content="来源"
                    Tag="sources">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="SettingsNotificationNavItem"
                    Content="通知"
                    Icon="Message"
                    Tag="notification" />
                <NavigationViewItem
                    x:Uid="SettingsAboutNavItem"
                    Content="关于"
                    Icon="Help"
                    Tag="about" />
            </NavigationView.MenuItems>

            <Frame x:Name="navFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <DrillInNavigationTransitionInfo />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
