<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FeedPeek.Pages.SourcesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:FeedPeek.Models">

    <ScrollView
        x:Name="SettingsScrollView"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Margin" Value="24,16,24,36" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Margin" Value="16,16,16,36" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="SettingsContent" Margin="24,16,24,36">
            <StackPanel Margin="0" MaxWidth="1000" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock
                    Margin="0,0,0,4"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="添加来源" />
                <controls:SettingsCard
                    Description="粘贴 RSS / Atom 地址或插件支持的直播间链接。"
                    Header="订阅地址"
                    HorizontalContentAlignment="Stretch">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Grid MinWidth="360" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 高度与 TextBox / NumberBox 等标准控件一致（TextControlThemeMinHeight = 32），
                             不要比它们更高，否则会把同行的输入框一起撑高。 -->
                        <TextBox
                            x:Name="EndpointTextBox"
                            VerticalAlignment="Center"
                            PlaceholderText="https://example.com/feed.xml"
                            KeyDown="EndpointTextBox_KeyDown" />
                        <Button
                            x:Name="AddButton"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            Click="AddButton_Click"
                            ToolTipService.ToolTip="添加订阅">
                            <FontIcon Glyph="&#xE710;" />
                        </Button>
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="从文件夹安装网站或直播间插件。"
                    Header="插件文件夹">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="InstallPluginButton"
                        Content="从文件夹选择"
                        Click="InstallPluginButton_Click" />
                </controls:SettingsCard>

                <!-- 提示条与紧随其后的分节标题放在同一个 Grid 里，作为 StackPanel 的单个子元素：
                     关闭状态的 InfoBar 仍会被 StackPanel 计入 Spacing，会让标题多出 4px。 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <InfoBar
                        x:Name="StatusInfoBar"
                        IsClosable="True"
                        IsOpen="False"
                        Visibility="Collapsed" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="我的订阅" />
                </Grid>
                <Grid MinHeight="180">
                        <ListView
                            x:Name="SourcesListView"
                            IsItemClickEnabled="False"
                            IsSwipeEnabled="False"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsTabStop" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SourceSettingsRow">
                                    <controls:SettingsCard
                                        AutomationProperties.Name="{x:Bind DisplayName}"
                                        DataContext="{x:Bind}"
                                        IsClickEnabled="True"
                                        Click="SourceCard_Click">
                                        <controls:SettingsCard.Header>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <PersonPicture Width="32" Height="32" ProfilePicture="{x:Bind IconSource}" Initials="{x:Bind Initials}" IsHitTestVisible="False" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </controls:SettingsCard.Header>
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            x:Name="EmptyPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon HorizontalAlignment="Center" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE774;" />
                            <TextBlock FontWeight="SemiBold" Text="还没有订阅" />
                        </StackPanel>
                </Grid>
                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="已安装插件" />
                <Grid MinHeight="180">
                    <ListView
                        x:Name="PluginsListView"
                        IsItemClickEnabled="False"
                        IsSwipeEnabled="False"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PluginSettingsRow">
                                <controls:SettingsCard
                                    AutomationProperties.Name="{x:Bind DisplayName}"
                                    DataContext="{x:Bind}"
                                    IsClickEnabled="True"
                                    Click="PluginCard_Click">
                                    <controls:SettingsCard.Header>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <PersonPicture Width="32" Height="32" ProfilePicture="{x:Bind IconSource}" Initials="{x:Bind Initials}" IsHitTestVisible="False" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </controls:SettingsCard.Header>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel
                        x:Name="PluginsEmptyPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <FontIcon HorizontalAlignment="Center" FontSize="28"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE74C;" />
                        <TextBlock FontWeight="SemiBold" Text="还没有安装插件" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollView>
</Page>
