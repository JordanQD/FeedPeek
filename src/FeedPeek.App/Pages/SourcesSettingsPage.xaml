<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FeedPeek.Pages.SourcesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:FeedPeek.Models">

    <ScrollView
        x:Name="SettingsScrollView"
        Padding="36,32,36,0"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsScrollView.Padding" Value="36,32,36,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsScrollView.Padding" Value="12,16,12,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Wrapped in a Grid to work around the SettingsExpander ItemsRepeater + parent MaxWidth layout bug -->
        <Grid>
            <StackPanel Margin="0,0,0,32" MaxWidth="1064" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock Margin="0,0,0,12" Style="{ThemeResource TitleTextBlockStyle}" Text="来源" />

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="添加来源" />

                <!-- RSS 订阅（第一位） -->
                <controls:SettingsCard
                    Description="输入网站地址或 RSS / Atom 地址，FeedPeek 会自动发现可用订阅。"
                    Header="订阅地址"
                    HorizontalContentAlignment="Stretch">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Grid MinWidth="360" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="EndpointTextBox"
                            PlaceholderText="https://example.com/feed.xml"
                            KeyDown="EndpointTextBox_KeyDown" />
                        <Button
                            x:Name="AddButton"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Padding="0"
                            VerticalAlignment="Center"
                            Click="AddButton_Click"
                            ToolTipService.ToolTip="添加来源">
                            <FontIcon Glyph="&#xE710;" />
                        </Button>
                    </Grid>
                </controls:SettingsCard>

                <!-- 网站插件（第二位） -->
                <controls:SettingsExpander
                    x:Name="PluginsExpander"
                    Description="安装、启用或管理网站插件；插件启用后即可添加对应网站来源。"
                    Header="已安装插件"
                    IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE74C;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="models:PluginSettingsRow">
                            <controls:SettingsCard
                                Description="{x:Bind Detail}"
                                Header="{x:Bind DisplayName}"
                                DataContext="{x:Bind}"
                                IsClickEnabled="True"
                                Click="PluginCard_Click">
                                <ToggleSwitch
                                    IsOn="{x:Bind IsEnabled}"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="PluginSwitch_Toggled" />
                            </controls:SettingsCard>
                        </DataTemplate>
                    </controls:SettingsExpander.ItemTemplate>
                    <controls:SettingsExpander.ItemsFooter>
                        <controls:SettingsCard
                            BorderThickness="0,1,0,0"
                            CornerRadius="0"
                            Description="从文件夹安装"
                            Header="安装插件"
                            MinHeight="52"
                            Padding="58,8,44,8">
                            <Button
                                x:Name="InstallPluginButton"
                                Width="36"
                                Height="36"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="InstallPluginButton_Click"
                                ToolTipService.ToolTip="从文件夹安装插件">
                                <FontIcon Glyph="&#xE8B7;" />
                            </Button>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.ItemsFooter>
                </controls:SettingsExpander>

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsClosable="True"
                    IsOpen="False" />

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="已添加的来源" />
                <Grid MinHeight="180">
                        <ListView
                            x:Name="SourcesListView"
                            IsItemClickEnabled="False"
                            IsSwipeEnabled="False"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsTabStop" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FeedSourceRow">
                                    <controls:SettingsCard
                                        Description="{x:Bind Category}"
                                        Header="{x:Bind DisplayName}"
                                        HeaderIcon="{x:Bind SourceIcon}"
                                        DataContext="{x:Bind}"
                                        IsClickEnabled="True"
                                        Click="SourceCard_Click" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            x:Name="EmptyPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon HorizontalAlignment="Center" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE774;" />
                            <TextBlock FontWeight="SemiBold" Text="还没有来源" />
                        </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollView>
</Page>
