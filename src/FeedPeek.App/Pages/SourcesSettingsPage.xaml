<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FeedPeek.Pages.SourcesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:FeedPeek.Models"
    xmlns:helpers="using:FeedPeek.Helpers">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.SettingsControls/SettingsExpander/SettingsExpander.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="PluginSubscriptionTemplate" x:DataType="models:SourceSettingsRow">
                <controls:SettingsCard
                    Header="{x:Bind DisplayName}" Description="{x:Bind GroupDetail}"
                    AutomationProperties.Name="{x:Bind DisplayName}"
                    DataContext="{x:Bind}" IsClickEnabled="True" Click="SourceCard_Click"
                    helpers:SettingsCardAvatar.IsEnabled="True"
                    helpers:SettingsCardAvatar.Source="{x:Bind IconSource}" />
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollView
        x:Name="SettingsScrollView"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Margin" Value="24,16,24,36" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Margin" Value="16,16,16,36" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="SettingsContent" Margin="24,16,24,36">
            <StackPanel Margin="0" MaxWidth="1000" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock
                    Margin="0,0,0,4"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="添加来源" />
                <controls:SettingsCard
                    Description="粘贴 RSS / Atom 地址或插件支持的直播间链接。"
                    Header="订阅地址"
                    HorizontalContentAlignment="Stretch">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Grid MinWidth="360" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 高度与 TextBox / NumberBox 等标准控件一致（TextControlThemeMinHeight = 32），
                             不要比它们更高，否则会把同行的输入框一起撑高。 -->
                        <TextBox
                            x:Name="EndpointTextBox"
                            VerticalAlignment="Center"
                            PlaceholderText="https://example.com/feed.xml"
                            KeyDown="EndpointTextBox_KeyDown" />
                        <Button
                            x:Name="AddButton"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            Click="AddButton_Click"
                            ToolTipService.ToolTip="添加订阅">
                            <FontIcon Glyph="&#xE710;" />
                        </Button>
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="从文件夹安装网站或直播间插件。"
                    Header="插件文件夹">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="InstallPluginButton"
                        Content="从文件夹选择"
                        Click="InstallPluginButton_Click" />
                </controls:SettingsCard>

                <!-- 提示条与紧随其后的分节标题放在同一个 Grid 里，作为 StackPanel 的单个子元素：
                     关闭状态的 InfoBar 仍会被 StackPanel 计入 Spacing，会让标题多出 4px。 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <InfoBar
                        x:Name="StatusInfoBar"
                        IsClosable="True"
                        IsOpen="False"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Uid="SourcesMySourcesHeader"
                        Grid.Row="1"
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="我的来源" />
                </Grid>
                <Grid x:Name="SourceGroupsContainer">
                        <ListView
                            x:Name="SourceGroupsListView"
                            IsItemClickEnabled="False"
                            IsSwipeEnabled="False"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsTabStop" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SourceSettingsGroup">
                                    <Grid>
                                        <controls:SettingsCard
                                            Visibility="{x:Bind SourceVisibility}"
                                            AutomationProperties.Name="{x:Bind Source.DisplayName}"
                                            DataContext="{x:Bind Source}"
                                            IsClickEnabled="True" Click="SourceCard_Click"
                                            Header="{x:Bind Source.DisplayName}" Description="{x:Bind Source.Detail}"
                                            helpers:SettingsCardAvatar.IsEnabled="True"
                                            helpers:SettingsCardAvatar.Source="{x:Bind Source.IconSource}" />
                                        <controls:SettingsExpander
                                            Visibility="{x:Bind PluginVisibility}"
                                            Header="{x:Bind DisplayName}" Description="{x:Bind Detail}"
                                            AutomationProperties.Name="{x:Bind DisplayName}" DataContext="{x:Bind}"
                                            ItemsSource="{x:Bind Subscriptions}" ItemTemplate="{StaticResource PluginSubscriptionTemplate}"
                                            helpers:SettingsCardAvatar.IsEnabled="True" helpers:SettingsCardAvatar.Source="{x:Bind IconSource}"
                                            Loaded="PluginExpander_Loaded" Expanded="PluginExpander_StateChanged" Collapsed="PluginExpander_StateChanged">
                                            <controls:SettingsExpander.ItemsFooter>
                                                <controls:SettingsCard
                                                    x:Uid="SourcesPluginSettingsCard" Header="插件设置"
                                                    Visibility="{x:Bind PluginSettingsVisibility}"
                                                    Style="{StaticResource DefaultSettingsExpanderItemStyle}">
                                                    <Button x:Uid="SourcesPluginSettingsButton" Content="设置"
                                                        AutomationProperties.Name="{x:Bind DisplayName}"
                                                        DataContext="{x:Bind Plugin}" Click="PluginCard_Click" />
                                                </controls:SettingsCard>
                                            </controls:SettingsExpander.ItemsFooter>
                                        </controls:SettingsExpander>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            x:Name="EmptyPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon HorizontalAlignment="Center" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE774;" />
                            <TextBlock x:Uid="SourcesEmptyList" FontWeight="SemiBold" Text="还没有添加来源或安装插件" />
                        </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollView>
</Page>
