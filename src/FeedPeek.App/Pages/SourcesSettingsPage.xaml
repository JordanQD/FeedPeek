<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FeedPeek.Pages.SourcesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:FeedPeek.Models">

    <ScrollView
        x:Name="SettingsScrollView"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Margin" Value="24,16,24,36" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Margin" Value="16,16,16,36" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Wrapped in a Grid to work around the SettingsExpander ItemsRepeater + parent MaxWidth layout bug -->
        <Grid x:Name="SettingsContent" Margin="24,16,24,36">
            <StackPanel Margin="0" MaxWidth="1000" Spacing="{StaticResource SettingsCardSpacing}">
                <!-- 添加来源（第一位）：RSS / Atom，或插件支持的直播间链接 -->
                <controls:SettingsCard
                    Description="输入网站地址、RSS / Atom 地址，或直接粘贴插件支持的直播间链接。"
                    Header="订阅地址"
                    HorizontalContentAlignment="Stretch">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Grid MinWidth="360" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 高度与 TextBox / NumberBox 等标准控件一致（TextControlThemeMinHeight = 32），
                             不要比它们更高，否则会把同行的输入框一起撑高。 -->
                        <TextBox
                            x:Name="EndpointTextBox"
                            VerticalAlignment="Center"
                            PlaceholderText="https://example.com/feed.xml"
                            KeyDown="EndpointTextBox_KeyDown" />
                        <Button
                            x:Name="AddButton"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            Click="AddButton_Click"
                            ToolTipService.ToolTip="添加来源">
                            <FontIcon Glyph="&#xE710;" />
                        </Button>
                    </Grid>
                </controls:SettingsCard>

                <!-- 安装插件（第二位）：与「订阅地址」同级的独立卡片 -->
                <controls:SettingsCard
                    Description="选择一个插件目录进行安装。"
                    Header="安装插件">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="InstallPluginButton"
                        VerticalAlignment="Center"
                        Click="InstallPluginButton_Click"
                        Content="从文件夹选择" />
                </controls:SettingsCard>

                <!-- 已添加来源（第三位）：已安装插件 + 已添加的 RSS / 插件来源 -->
                <controls:SettingsExpander
                    x:Name="AddedSourcesExpander"
                    Description="已安装的插件，以及已添加的 RSS 与插件来源。"
                    Header="已添加来源"
                    IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE74C;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="models:AddedSourceEntry">
                            <controls:SettingsCard
                                Description="{x:Bind Detail}"
                                Header="{x:Bind DisplayName}"
                                HeaderIcon="{x:Bind Icon}"
                                DataContext="{x:Bind}"
                                IsClickEnabled="True"
                                Click="AddedSourceCard_Click" />
                        </DataTemplate>
                    </controls:SettingsExpander.ItemTemplate>
                </controls:SettingsExpander>

                <!-- 提示条与紧随其后的分节标题放在同一个 Grid 里，作为 StackPanel 的单个子元素：
                     关闭状态的 InfoBar 仍会被 StackPanel 计入 Spacing，会让标题多出 4px。 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <InfoBar
                        x:Name="StatusInfoBar"
                        IsClosable="True"
                        IsOpen="False"
                        Visibility="Collapsed" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="已添加的来源" />
                </Grid>
                <Grid MinHeight="180">
                        <ListView
                            x:Name="SourcesListView"
                            IsItemClickEnabled="False"
                            IsSwipeEnabled="False"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsTabStop" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FeedSourceRow">
                                    <controls:SettingsCard
                                        Description="{x:Bind Category}"
                                        Header="{x:Bind DisplayName}"
                                        HeaderIcon="{x:Bind SourceIcon}"
                                        DataContext="{x:Bind}"
                                        IsClickEnabled="True"
                                        Click="SourceCard_Click" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            x:Name="EmptyPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <FontIcon HorizontalAlignment="Center" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE774;" />
                            <TextBlock FontWeight="SemiBold" Text="还没有来源" />
                        </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollView>
</Page>
