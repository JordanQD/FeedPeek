<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="FeedPeek.Pages.NotificationDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:FeedPeek.Models"
    xmlns:helpers="using:FeedPeek.Helpers">
    <Page.Resources>
        <DataTemplate x:Key="NotificationCandidateTemplate" x:DataType="models:NotificationCandidateRow">
            <controls:SettingsCard Header="{x:Bind DisplayName}" Description="{x:Bind Detail}"
                AutomationProperties.Name="{x:Bind DisplayName}"
                helpers:SettingsCardAvatar.IsEnabled="True" helpers:SettingsCardAvatar.Source="{x:Bind IconSource}" />
        </DataTemplate>
    </Page.Resources>
    <ScrollView VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <VisualStateManager.VisualStateGroups><VisualStateGroup>
            <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="640" /></VisualState.StateTriggers>
                <VisualState.Setters><Setter Target="DetailContent.Margin" Value="24,16,24,36" /></VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                <VisualState.Setters><Setter Target="DetailContent.Margin" Value="16,16,16,36" /></VisualState.Setters>
            </VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <StackPanel x:Name="DetailContent" MaxWidth="1000" Margin="24,16,24,36" Spacing="{StaticResource SettingsCardSpacing}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="16" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <PersonPicture x:Name="SourcePicture" Width="64" Height="64" IsHitTestVisible="False" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="SourceName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="SourceKind" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <InfoBar x:Name="StatusInfoBar" Grid.Row="1" Visibility="Collapsed" IsClosable="True" />
            </Grid>
            <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid x:Name="CreatorPolicyPanel" Visibility="Collapsed" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:SettingsCard x:Name="CreatorScopeCard" x:Uid="NotificationCreatorScopeCard" Grid.Row="0" Header="作者范围" Description="仅在自定义来源通知模式下生效。">
                    <ComboBox x:Name="CreatorScopeComboBox" x:Uid="NotificationCreatorScopeBox" MinWidth="160" MaxWidth="300" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CreatorNotificationScope" AutomationProperties.Name="作者范围" SelectionChanged="CreatorScopeComboBox_SelectionChanged">
                        <ComboBoxItem x:Name="MixedCreatorScopeItem" x:Uid="NotificationMixedCreatorScopeItem" Tag="mixed" Content="按通知类型分别设置（保留旧配置）" />
                        <ComboBoxItem x:Name="AllFollowingCreatorScopeItem" x:Uid="NotificationAllFollowingCreatorScopeItem" Tag="all" Content="全部已关注作者" />
                        <ComboBoxItem x:Name="SelectedCreatorScopeItem" x:Uid="NotificationSelectedCreatorScopeItem" Tag="selected" Content="自选作者" />
                    </ComboBox>
                </controls:SettingsCard>
                <TextBlock x:Name="CreatorGlobalModeText" Grid.Row="1" Margin="1,4,0,0" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <controls:SettingsCard x:Name="AddCreatorCard" x:Uid="NotificationAddSelectedCreatorCard" Grid.Row="2" Margin="0,4,0,0" Header="搜索已关注作者" Description="搜索并选择要通知的作者。" AutomationProperties.AutomationId="AddSelectedNotificationCreator" IsClickEnabled="True" Click="AddCreatorCard_Click" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="NotificationTypesHeader" Grid.Row="1" x:Uid="NotificationDetailSectionHeader" Text="通知类型" Margin="0,0,0,4" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
            </Grid>
            <StackPanel>
                <controls:SettingsCard x:Name="UpdatesCard" x:Uid="NotificationDetailUpdatesCard" Header="更新通知" Description="此来源出现新内容时提醒。" Visibility="Collapsed">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE714;" /></controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="UpdatesSwitch" x:Uid="NotificationDetailUpdatesSwitch" AutomationProperties.Name="更新通知" AutomationProperties.AutomationId="SourceUpdatesNotificationSwitch" Toggled="NotificationSwitch_Toggled" />
                </controls:SettingsCard>
                <controls:SettingsCard x:Name="LiveCard" x:Uid="NotificationDetailLiveCard" Header="开播通知" Description="此来源开始直播时提醒。" Visibility="Collapsed">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE789;" /></controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="LiveSwitch" x:Uid="NotificationDetailLiveSwitch" AutomationProperties.Name="开播通知" AutomationProperties.AutomationId="SourceLiveNotificationSwitch" Toggled="NotificationSwitch_Toggled" />
                </controls:SettingsCard>
                <TextBlock x:Name="UnavailableText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="CreatorPersonalInfoText" Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Uid="NotificationDetailSettingsHeader" Text="来源设置" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
            <StackPanel>
                <controls:SettingsCard x:Name="OpenSourceCard" x:Uid="NotificationOpenSourceCard" Header="打开来源设置" IsClickEnabled="True" IsEnabled="False" Click="OpenSource_Click" />
                <controls:SettingsCard x:Name="ViewPluginCard" x:Uid="NotificationViewPluginCard" Header="查看插件" IsClickEnabled="True" Visibility="Collapsed" Click="ViewPlugin_Click" Margin="0,4,0,0" />
            </StackPanel>
            <Grid x:Name="NotificationManagementPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Uid="NotificationDetailManagementHeader" Text="管理" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
            <controls:SettingsCard Grid.Row="1" x:Uid="NotificationDeleteRuleCard" Header="删除此通知项" Description="保留来源及其内容。删除的通知项不会自动补回。">
                <Button x:Name="DeleteButton" x:Uid="NotificationDeleteRuleButton" Content="删除" IsEnabled="False" Click="Delete_Click" AutomationProperties.AutomationId="DeleteNotificationRuleButton" />
            </controls:SettingsCard>
            </Grid>
        </StackPanel>
    </ScrollView>
</Page>
