<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FeedPeek.Pages.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollView
        x:Name="SettingsScrollView"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Margin" Value="24,16,24,36" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Margin" Value="16,16,16,36" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel
            x:Name="SettingsContent"
            Margin="24,16,24,36"
            MaxWidth="1000"
            Spacing="{StaticResource SettingsCardSpacing}">
            <StackPanel.ChildrenTransitions>
                <EntranceThemeTransition FromVerticalOffset="36" />
                <RepositionThemeTransition IsStaggeringEnabled="False" />
            </StackPanel.ChildrenTransitions>

            <TextBlock
                x:Uid="GeneralStartupSectionHeader"
                Margin="0,0,0,4"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="启动" />
            <!-- 卡片与紧随其后的提示条必须是 StackPanel 的同一个子元素：关闭状态的 InfoBar 会变成
                 Collapsed，而 StackPanel 仍为折叠子元素计入 Spacing，导致与下方卡片的间距翻倍。 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:SettingsCard
                    x:Uid="GeneralAutoStartCard"
                    Description="登录 Windows 后自动启动应用。"
                    Header="开机后自动运行">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="AutoStartSwitch"
                        x:Uid="GeneralAutoStartSwitch"
                        AutomationProperties.AutomationId="AutoStartSwitch"
                        AutomationProperties.Name="开机后自动运行"
                        Toggled="AutoStartSwitch_Toggled" />
                </controls:SettingsCard>
                <InfoBar
                    x:Name="StartupInfoBar"
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational"
                    Visibility="Collapsed" />
            </Grid>

            <controls:SettingsCard
                x:Uid="GeneralRunningLaunchActionCard"
                Description="应用已经在后台运行时，从开始菜单再次打开后的行为。"
                Header="重复打开应用时">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8EE;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="RunningLaunchActionBox"
                    x:Uid="GeneralRunningLaunchActionBox"
                    MinWidth="160"
                    MaxWidth="300"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="RunningLaunchActionBox"
                    AutomationProperties.Name="重复打开应用时"
                    SelectionChanged="RunningLaunchActionBox_SelectionChanged">
                    <ComboBoxItem x:Uid="GeneralRunningLaunchOpenSettingsItem" Content="打开设置" />
                    <ComboBoxItem x:Uid="GeneralRunningLaunchOpenCustomWebPageItem" Content="打开自定义网页" />
                </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard
                x:Uid="GeneralCustomLaunchWebPageCard"
                Description="重复打开应用并选择打开网页时使用。"
                Header="自定义网页">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsCard.HeaderIcon>
                <TextBox
                    x:Name="CustomLaunchWebPageUrlBox"
                    x:Uid="GeneralCustomLaunchWebPageUrlBox"
                    MinWidth="200"
                    MaxWidth="400"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="CustomLaunchWebPageUrlBox"
                    AutomationProperties.Name="自定义网页"
                    LostFocus="CustomLaunchWebPageUrlBox_LostFocus"
                    PlaceholderText="https://github.com/JordanQD/FeedPeek"
                    TextChanged="CustomLaunchWebPageUrlBox_TextChanged" />
            </controls:SettingsCard>
            <controls:SettingsCard
                x:Uid="GeneralDefaultOpenPageCard"
                Description="重新打开托盘弹窗时的默认页面；开启“保留弹窗位置”后优先恢复上次页面。"
                Header="默认打开页面">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71B;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="DefaultOpenPageBox"
                    x:Uid="GeneralDefaultOpenPageBox"
                    MinWidth="160"
                    MaxWidth="300"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="DefaultOpenPageBox"
                    AutomationProperties.Name="默认打开页面"
                    SelectionChanged="DefaultOpenPageBox_SelectionChanged">
                    <ComboBoxItem x:Uid="GeneralDefaultOpenFollowingItem" Content="关注" />
                    <ComboBoxItem x:Uid="GeneralDefaultOpenHistoryItem" Content="历史" />
                    <ComboBoxItem x:Uid="GeneralDefaultOpenViewLaterItem" Content="稍后再看" />
                </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard
                x:Uid="GeneralSaveMainPanelPositionCard"
                Description="开启后记住上次页面和直播区域展开状态；关闭此选项后，每次打开按默认设置显示。"
                Header="保留弹窗位置">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE81C;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="SaveMainPanelPositionSwitch"
                    x:Uid="GeneralSaveMainPanelPositionSwitch"
                    AutomationProperties.AutomationId="SaveMainPanelPositionSwitch"
                    AutomationProperties.Name="保留弹窗位置"
                    Toggled="SaveMainPanelPositionSwitch_Toggled" />
            </controls:SettingsCard>

            <TextBlock
                x:Uid="GeneralDisplaySectionHeader"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="显示" />
            <controls:SettingsCard
                x:Uid="GeneralMainPanelHeightCard"
                Description="设置托盘主弹窗的高度。关闭并重新打开弹窗后生效，实际高度受屏幕可用空间限制。"
                Header="主弹窗高度">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="MainPanelHeightBox"
                    x:Uid="GeneralMainPanelHeightBox"
                    MinWidth="160"
                    MaxWidth="300"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="MainPanelHeightBox"
                    AutomationProperties.Name="主弹窗高度"
                    SelectionChanged="MainPanelHeightBox_SelectionChanged">
                    <ComboBoxItem x:Uid="GeneralMainPanelHeight600Item" Content="600" Tag="600" />
                    <ComboBoxItem x:Uid="GeneralMainPanelHeight800Item" Content="800" Tag="800" />
                    <ComboBoxItem x:Uid="GeneralMainPanelHeight1000Item" Content="1000" Tag="1000" />
                </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard
                x:Uid="GeneralLiveSectionDisplayModeCard"
                Description="设置关注页直播区域的默认显示方式。关闭并重新打开托盘弹窗后生效。"
                Header="正在直播">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B2;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="LiveSectionDisplayModeBox"
                    x:Uid="GeneralLiveSectionDisplayModeBox"
                    MinWidth="160"
                    MaxWidth="300"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="LiveSectionDisplayModeBox"
                    AutomationProperties.Name="正在直播"
                    SelectionChanged="LiveSectionDisplayModeBox_SelectionChanged">
                    <ComboBoxItem x:Uid="GeneralLiveExpandedItem" Content="默认展开显示" />
                    <ComboBoxItem x:Uid="GeneralLiveCollapsedItem" Content="默认折叠显示" />
                    <ComboBoxItem x:Uid="GeneralLiveHiddenItem" Content="不显示" />
                </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard
                x:Uid="GeneralKeepSourceFilterCard"
                Description="开启后记住上次选择的来源，下次打开继续筛选；关闭后，下次打开显示所有来源。"
                Header="保留源筛选">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71C;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="KeepSourceFilterSwitch"
                    x:Uid="GeneralKeepSourceFilterSwitch"
                    AutomationProperties.AutomationId="KeepSourceFilterSwitch"
                    AutomationProperties.Name="保留源筛选"
                    Toggled="KeepSourceFilterSwitch_Toggled" />
            </controls:SettingsCard>

            <TextBlock
                x:Uid="GeneralConfigSectionHeader"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="配置" />
            <controls:SettingsCard
                x:Uid="GeneralExportConfigCard"
                Description="备份通用设置、来源订阅和通知规则；不包含插件文件和登录凭据。"
                Header="导出配置">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEDE1;" />
                </controls:SettingsCard.HeaderIcon>
                <Button
                    x:Name="ExportConfigButton"
                    x:Uid="GeneralExportConfigButton"
                    AutomationProperties.AutomationId="ExportConfigButton"
                    Click="ExportConfigButton_Click"
                    Content="导出" />
            </controls:SettingsCard>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:SettingsCard
                    x:Uid="GeneralImportConfigCard"
                    Description="从 JSON 文件合并恢复设置、来源订阅和通知规则。对应插件需另外安装并登录。"
                    Header="导入配置">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEDE2;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="ImportConfigButton"
                        x:Uid="GeneralImportConfigButton"
                        AutomationProperties.AutomationId="ImportConfigButton"
                        Click="ImportConfigButton_Click"
                        Content="导入" />
                </controls:SettingsCard>
                <InfoBar
                    x:Name="ConfigInfoBar"
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    IsClosable="True"
                    IsOpen="False"
                    Visibility="Collapsed" />
            </Grid>

            <controls:SettingsCard
                x:Name="LanguageSettingsCard"
                x:Uid="GeneralLanguageCard"
                Description="选择跟随 Windows 语言，或手动指定界面显示语言。重启应用后生效。"
                Header="界面语言">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF2B7;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="LanguageSelectorBox"
                    x:Uid="GeneralLanguageSelectorBox"
                    MinWidth="160"
                    MaxWidth="300"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="LanguageSelectorBox"
                    AutomationProperties.Name="界面语言"
                    SelectionChanged="LanguageSelectorBox_SelectionChanged">
                    <ComboBoxItem x:Uid="GeneralLanguageSystemItem" Content="跟随系统" Tag="system" />
                    <ComboBoxItem x:Uid="GeneralLanguageZhCnItem" Content="简体中文" Tag="zh-CN" />
                    <ComboBoxItem x:Uid="GeneralLanguageZhHkItem" Content="繁體中文（香港）" Tag="zh-HK" />
                </ComboBox>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollView>
</Page>
