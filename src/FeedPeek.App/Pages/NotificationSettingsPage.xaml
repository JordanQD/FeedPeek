<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FeedPeek.Pages.NotificationSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:FeedPeek.Models"
    xmlns:helpers="using:FeedPeek.Helpers">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.SettingsControls/SettingsExpander/SettingsExpander.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="NotificationCandidateTemplate" x:DataType="models:NotificationCandidateRow">
            <controls:SettingsCard Header="{x:Bind DisplayName}" Description="{x:Bind Detail}"
                AutomationProperties.Name="{x:Bind DisplayName}"
                helpers:SettingsCardAvatar.IsEnabled="True" helpers:SettingsCardAvatar.Source="{x:Bind IconSource}" />
        </DataTemplate>
        <DataTemplate x:Key="NotificationRuleTemplate" x:DataType="models:NotificationRuleRow">
            <controls:SettingsCard IsClickEnabled="True" DataContext="{x:Bind}" Click="NotificationRule_Click"
                Header="{x:Bind DisplayName}" Description="{x:Bind GroupDetail}" AutomationProperties.Name="{x:Bind DisplayName}"
                helpers:SettingsCardAvatar.IsEnabled="True" helpers:SettingsCardAvatar.Source="{x:Bind IconSource}" />
        </DataTemplate>
        <DataTemplate x:Key="PluginNotificationSettingsTemplate" x:DataType="models:NotificationFooterRow">
            <controls:SettingsCard x:Uid="NotificationPluginSettingsCard" Header="通知设置" Description="{x:Bind Description}"
                Style="{StaticResource DefaultSettingsExpanderItemStyle}">
                <Button x:Uid="NotificationPluginSettingsButton" Content="设置" DataContext="{x:Bind Rule}"
                    AutomationProperties.Name="{x:Bind Rule.DisplayName}" Click="NotificationRule_Click" />
            </controls:SettingsCard>
        </DataTemplate>
        <DataTemplate x:Key="PluginNotificationAddTemplate" x:DataType="models:NotificationFooterRow">
            <controls:SettingsCard x:Uid="NotificationPluginAddCard" Header="添加通知" Description="{x:Bind Description}"
                Style="{StaticResource DefaultSettingsExpanderItemStyle}" IsEnabled="{x:Bind Rule.IsAvailable}">
                <Button x:Uid="NotificationPluginAddButton" Content="添加通知" DataContext="{x:Bind Rule}"
                    AutomationProperties.Name="添加通知" Click="PluginAddNotification_Click" />
            </controls:SettingsCard>
        </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollView
        x:Name="SettingsScrollView"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Margin" Value="24,16,24,36" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Margin" Value="16,16,16,36" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel
            x:Name="SettingsContent"
            Margin="24,16,24,36"
            MaxWidth="1000"
            Spacing="{StaticResource SettingsCardSpacing}">
            <StackPanel.ChildrenTransitions>
                <RepositionThemeTransition IsStaggeringEnabled="False" />
            </StackPanel.ChildrenTransitions>

            <TextBlock
                x:Uid="NotificationTargetSectionHeader"
                Margin="0,0,0,4"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="通知对象" />
            <controls:SettingsCard
                x:Name="NotificationTargetCard"
                x:Uid="NotificationTargetCard"
                Description="选择所有来源、自定义来源或关闭通知。"
                Header="通知对象">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE715;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="NotificationTargetModeBox"
                    x:Uid="NotificationTargetModeBox"
                    MinWidth="160"
                    MaxWidth="300"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="NotificationTargetModeBox"
                    AutomationProperties.Name="通知对象"
                    SelectionChanged="NotificationTargetModeBox_SelectionChanged">
                    <ComboBoxItem x:Uid="NotificationTargetNoneItem" Content="不通知" />
                    <ComboBoxItem x:Uid="NotificationTargetAllFollowingItem" Content="所有来源更新" />
                    <ComboBoxItem x:Uid="NotificationTargetCustomCreatorsItem" Content="自定义来源通知" />
                </ComboBox>
            </controls:SettingsCard>

            <StackPanel x:Name="ActiveNotificationPanel" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock
                x:Name="NotificationIntervalSectionHeader"
                x:Uid="NotificationIntervalSectionHeader"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="检查频率" />
            <controls:SettingsCard
                x:Name="NotificationIntervalCard"
                x:Uid="NotificationIntervalCard"
                Description="应用在后台检查动态和直播状态的时间间隔。"
                Header="通知检查间隔（分钟）">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE823;" />
                </controls:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="NotificationCheckIntervalBox"
                    x:Uid="NotificationCheckIntervalBox"
                    MinWidth="120"
                    MaxWidth="200"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="NotificationCheckIntervalBox"
                    AutomationProperties.Name="通知检查间隔（分钟）"
                    Minimum="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="NotificationCheckIntervalBox_ValueChanged" />
            </controls:SettingsCard>

            <Grid>
            <StackPanel x:Name="GlobalNotificationPanel" Spacing="{StaticResource SettingsCardSpacing}">
            <controls:SettingsCard
                x:Name="GlobalVideoNotificationCard"
                x:Uid="NotificationVideoNotifyCard"
                Description="来源出现新内容时提醒。"
                Header="更新通知">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE714;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="VideoNotificationSwitch"
                    x:Uid="NotificationVideoNotificationSwitch"
                    AutomationProperties.AutomationId="VideoNotificationSwitch"
                    AutomationProperties.Name="更新通知"
                    Toggled="VideoNotificationSwitch_Toggled" />
            </controls:SettingsCard>
            <controls:SettingsCard
                x:Name="GlobalLiveNotificationCard"
                x:Uid="NotificationLiveNotifyCard"
                Description="来源开始直播时提醒。"
                Header="开播通知">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE789;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="LiveNotificationSwitch"
                    x:Uid="NotificationLiveNotificationSwitch"
                    AutomationProperties.AutomationId="LiveNotificationSwitch"
                    AutomationProperties.Name="开播通知"
                    Toggled="LiveNotificationSwitch_Toggled" />
            </controls:SettingsCard>

            </StackPanel>
            <StackPanel x:Name="CustomNotificationPanel" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock x:Uid="NotificationCustomSectionHeader" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="自定义通知" />
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="CustomNotificationStatusText" Margin="1,0,0,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EmptyNotificationsText" x:Uid="NotificationEmptyList" Text="还没有已添加的来源。请先在来源页面添加订阅或插件来源。" Margin="1,12,0,0" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                        <ListView x:Name="NotificationGroupsList" SelectionMode="None" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" /><Setter Property="IsTabStop" Value="False" />
                            </Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate><DataTemplate x:DataType="models:NotificationSettingsGroup">
                                <Grid>
                                    <controls:SettingsCard Visibility="{x:Bind SourceVisibility}" IsClickEnabled="True"
                                        Header="{x:Bind Source.DisplayName}" Description="{x:Bind Source.Detail}"
                                        AutomationProperties.Name="{x:Bind Source.DisplayName}" DataContext="{x:Bind Source}"
                                        Click="NotificationRule_Click" helpers:SettingsCardAvatar.IsEnabled="True"
                                        helpers:SettingsCardAvatar.Source="{x:Bind Source.IconSource}" />
                                    <controls:SettingsExpander Visibility="{x:Bind PluginVisibility}"
                                        Header="{x:Bind DisplayName}" Description="{x:Bind Detail}" AutomationProperties.Name="{x:Bind DisplayName}"
                                        DataContext="{x:Bind}" ItemsSource="{x:Bind NotificationItems}" ItemTemplate="{StaticResource NotificationRuleTemplate}"
                                        helpers:SettingsCardAvatar.IsEnabled="True" helpers:SettingsCardAvatar.Source="{x:Bind IconSource}"
                                        Loaded="PluginExpander_Loaded" Expanded="PluginExpander_StateChanged" Collapsed="PluginExpander_StateChanged">
                                        <controls:SettingsExpander.ItemsFooter>
                                            <StackPanel>
                                                <ItemsRepeater ItemsSource="{x:Bind SettingsTargets}" ItemTemplate="{StaticResource PluginNotificationSettingsTemplate}" />
                                                <ItemsRepeater ItemsSource="{x:Bind FooterAddTargets}" ItemTemplate="{StaticResource PluginNotificationAddTemplate}" />
                                            </StackPanel>
                                        </controls:SettingsExpander.ItemsFooter>
                                    </controls:SettingsExpander>
                                </Grid>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </StackPanel>
            </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollView>
</Page>
