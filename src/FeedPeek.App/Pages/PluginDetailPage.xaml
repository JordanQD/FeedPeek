<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FeedPeek.Pages.PluginDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:FeedPeek.Pages">

    <Page.Resources>
        <!-- BreadcrumbBar 的箭头（chevron）字号由这个主题资源控制（见 generic.xaml） -->
        <x:Double x:Key="BreadcrumbBarChevronFontSize">20</x:Double>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollView
        x:Name="DetailScrollView"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailContent.Margin" Value="24,16,24,36" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailContent.Margin" Value="16,16,16,36" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel x:Name="DetailContent" Margin="24,16,24,36" MaxWidth="1000" Spacing="{StaticResource SettingsCardSpacing}">
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,16">
                <Button
                    x:Name="IconButton"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="修改图标">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="从文件选择图标" Click="PickIconFile_Click" />
                            <MenuFlyoutItem Text="恢复默认图标" Click="ResetIcon_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <Grid Width="96" Height="96" PointerEntered="IconGrid_PointerEntered" PointerExited="IconGrid_PointerExited">
                        <PersonPicture x:Name="IconPicture" Width="96" Height="96" />
                        <Border
                            x:Name="EditOverlay"
                            Width="96"
                            Height="96"
                            CornerRadius="48"
                            Background="#66000000"
                            Visibility="Collapsed">
                            <FontIcon
                                Glyph="&#xE70F;"
                                FontSize="28"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="HeroName" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="HeroVersion"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <controls:SettingsCard
                x:Name="PluginCard"
                Description="版本"
                Header="插件">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE74C;" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Name="LoginCard"
                Header="登录状态">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE77B;" />
                </controls:SettingsCard.HeaderIcon>
                <Button
                    x:Name="LoginButton"
                    Click="LoginButton_Click" />
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Name="WebsiteCard"
                Description="主面板「打开源网站」使用的网址。未设置时打开前会询问。"
                Header="打开的网页">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </controls:SettingsCard.HeaderIcon>
                <Grid MinWidth="360" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="WebsiteBox"
                        PlaceholderText="https://"
                        AutomationProperties.AutomationId="PluginWebsiteBox"
                        AutomationProperties.Name="打开的网页" />
                    <Button
                        x:Name="SaveWebsiteButton"
                        Grid.Column="1"
                        Click="SaveWebsiteButton_Click"
                        Content="保存" />
                </Grid>
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="删除插件及其来源和本地缓存"
                Header="删除插件">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE74D;" />
                </controls:SettingsCard.HeaderIcon>
                <Button
                    x:Name="DeletePluginButton"
                    Content="删除插件"
                    Click="DeletePluginButton_Click" />
            </controls:SettingsCard>

            <InfoBar
                x:Name="StatusInfoBar"
                IsClosable="True"
                IsOpen="False"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollView>
</Page>
