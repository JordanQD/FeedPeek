<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FeedPeek.Pages.PluginDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:FeedPeek.Pages">

    <Page.Resources>
        <!-- BreadcrumbBar 的箭头（chevron）字号由这个主题资源控制（见 generic.xaml） -->
        <x:Double x:Key="BreadcrumbBarChevronFontSize">20</x:Double>
    </Page.Resources>

    <ScrollView
        x:Name="DetailScrollView"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailContent.Margin" Value="24,16,24,36" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailContent.Margin" Value="16,16,16,36" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel x:Name="DetailContent" Margin="24,16,24,36" MaxWidth="1000" Spacing="{StaticResource SettingsCardSpacing}">
            <controls:SettingsCard
                x:Name="PluginCard"
                Description="版本"
                Header="插件" />

            <controls:SettingsCard
                x:Name="LoginCard"
                Header="登录状态">
                <Button
                    x:Name="LoginButton"
                    Click="LoginButton_Click" />
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Name="AddSourceCard"
                Description="为该网站插件添加订阅来源"
                Header="添加来源">
                <Button
                    x:Name="AddSourceButton"
                    Content="添加来源"
                    Click="AddSourceButton_Click" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="删除插件及其来源和本地缓存"
                Header="删除插件">
                <Button
                    x:Name="DeletePluginButton"
                    Content="删除插件"
                    Click="DeletePluginButton_Click" />
            </controls:SettingsCard>

            <InfoBar
                x:Name="StatusInfoBar"
                IsClosable="True"
                IsOpen="False"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollView>
</Page>
