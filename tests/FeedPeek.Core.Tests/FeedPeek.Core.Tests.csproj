<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FeedPeek.Core\FeedPeek.Core.csproj" />
    <ProjectReference Include="..\..\src\FeedPeek.PluginContracts\FeedPeek.PluginContracts.csproj" />
    <ProjectReference Include="..\..\src\FeedPeek.PluginHost\FeedPeek.PluginHost.csproj" />
    <ProjectReference Include="..\..\src\FeedPeek.PluginRuntime\FeedPeek.PluginRuntime.csproj" />
    <ProjectReference Include="..\..\src\FeedPeek.Rss\FeedPeek.Rss.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\src\FeedPeek.App\Helpers\LocalImageFile.cs" Link="AppHelpers\LocalImageFile.cs" />
    <Compile Include="..\..\src\FeedPeek.App\Services\NotificationStateChanges.cs" Link="AppServices\NotificationStateChanges.cs" />
    <Compile Include="..\..\src\FeedPeek.App\Services\CreatorNotificationStatusCache.cs" Link="AppServices\CreatorNotificationStatusCache.cs" />
    <Compile Include="..\..\src\FeedPeek.App\Services\PanelLiveCache.cs" Link="AppServices\PanelLiveCache.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\Plugins\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\SiteResponses\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\FeedPeek.Compatibility.Tests\Fixtures\dynamic-video-page.json"
          Link="Fixtures\SiteResponses\dynamic-video-page.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\FeedPeek.Compatibility.Tests\Fixtures\history-page.json"
          Link="Fixtures\SiteResponses\history-page.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\FeedPeek.Compatibility.Tests\Fixtures\view-later-page.json"
          Link="Fixtures\SiteResponses\view-later-page.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
